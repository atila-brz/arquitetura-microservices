{
  "name": "arquitetura-microservices",
  "version": "1.0.0",
  "description": "Consulta de clima com API Gateway (Express) e microsserviços que usam a Open-Meteo",
  "private": true,
  "workspaces": [
    "gateway",
    "services/localizacao",
    "services/meteorologia",
    "services/historico"
  ],
  "scripts": {
    "start": "node start.js",
    "start:gateway": "npm start -w gateway",
    "start:localizacao": "npm start -w services/localizacao",
    "start:meteorologia": "npm start -w services/meteorologia",
    "start:historico": "npm start -w services/historico",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
